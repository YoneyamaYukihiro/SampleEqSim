<Window x:Class="SampleEqSim.Equipment.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SampleEqSim.Equipment.ViewModels"
        xmlns:conv="clr-namespace:SampleEqSim.Equipment.Views.Converters"
        mc:Ignorable="d"
        Title="SECS/GEM Equipment Simulator [装置]" Height="780" Width="1100"
        Icon="pack://application:,,,/equipment.ico"
        Background="#F0FDFA">

    <Window.Resources>
        <conv:BoolToAlarmColorConverter x:Key="BoolToAlarmColor"/>
        <conv:StringToLedBrushConverter x:Key="LedBrush"/>

        <Style x:Key="LedIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StateLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" Background="#0F766E" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙ EQUIPMENT 装置シミュレータ  "
                               FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionSummary}"
                               FontSize="13" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentTime}"
                           FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Top" Background="#115E59" Padding="12,6">
            <UniformGrid Rows="1" Columns="3">
                <!-- Communication State -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="COMM:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Ellipse Style="{StaticResource LedIndicator}"
                             Fill="{Binding CommunicationStateBrush, Converter={StaticResource LedBrush}}"/>
                    <TextBlock Text="{Binding CommunicationStateText}" Style="{StaticResource StateLabel}" Foreground="White"/>
                </StackPanel>
                <!-- Control State -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CTRL:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Ellipse Style="{StaticResource LedIndicator}"
                             Fill="{Binding ControlStateBrush, Converter={StaticResource LedBrush}}"/>
                    <TextBlock Text="{Binding ControlStateText}" Style="{StaticResource StateLabel}" Foreground="White"/>
                </StackPanel>
                <!-- Processing State -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PROC:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Ellipse Style="{StaticResource LedIndicator}"
                             Fill="{Binding ProcessingStateBrush, Converter={StaticResource LedBrush}}"/>
                    <TextBlock Text="{Binding ProcessingStateText}" Style="{StaticResource StateLabel}" Foreground="White"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左パネル: 操作 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel>

                <!-- 接続設定 (HSMS) -->
                <GroupBox Header="接続設定 (HSMS)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IPアドレス" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Margin="4,2" Padding="4,2"
                                       Text="{Binding ConnIpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ポート" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Margin="4,2" Padding="4,2"
                                       Text="{Binding ConnPort, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DeviceId" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Margin="4,2" Padding="4,2"
                                       Text="{Binding ConnDeviceId, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <CheckBox Content="Active モード (自分から相手へ接続する)" Margin="4,4"
                                  IsChecked="{Binding ConnIsActive}"/>
                        <TextBlock Text="※ Passive は待受 (IP=0.0.0.0 で全NIC)。保存すると確認後にアプリを再起動して反映します。"
                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="4,0"/>
                        <Button Content="保存して再接続 (再起動)" Style="{StaticResource Btn}" Margin="4,4,4,0"
                                Command="{Binding SaveAndReconnectCommand}"/>
                    </StackPanel>
                </GroupBox>

                <!-- シーケンス監視 -->
                <GroupBox Header="シーケンス監視 (想定順序との照合)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding SequenceStatusBrush, Converter={StaticResource LedBrush}}"/>
                                <TextBlock Text="{Binding SequenceName}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="再読込"  Style="{StaticResource Btn}" Command="{Binding ReloadSequenceCommand}"/>
                            <Button Grid.Column="2" Content="リセット" Style="{StaticResource Btn}" Command="{Binding ResetSequenceCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding SequenceStatus}" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{Binding SequenceStatusBrush, Converter={StaticResource LedBrush}}"/>
                        <ItemsControl ItemsSource="{Binding SequenceSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="11" Height="11" Margin="2,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding StatusBrush, Converter={StaticResource LedBrush}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="※ sequence.json (exe同フォルダ) の順序と実通信を照合。緑=受信 / 黄=次に期待 / 赤=スキップ・逸脱"
                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 処理状態操作 -->
                <GroupBox Header="処理状態 (Processing State)" Style="{StaticResource GroupBoxStyle}">
                    <UniformGrid Rows="2" Columns="3">
                        <Button Content="IDLE" Style="{StaticResource Btn}" Command="{Binding SetIdleCommand}"/>
                        <Button Content="SETUP" Style="{StaticResource Btn}" Command="{Binding SetSetupCommand}"/>
                        <Button Content="READY" Style="{StaticResource Btn}" Command="{Binding SetReadyCommand}"/>
                        <Button Content="EXECUTE" Style="{StaticResource Btn}" Command="{Binding SetExecutingCommand}"/>
                        <Button Content="PAUSE" Style="{StaticResource Btn}" Command="{Binding SetPauseCommand}"/>
                    </UniformGrid>
                </GroupBox>

                <!-- 装置プロセス値 -->
                <GroupBox Header="プロセス値" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="温度 (°C)" VerticalAlignment="Center"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="500"
                                Value="{Binding Temperature}" TickFrequency="10" Margin="4,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="圧力 (kPa)" VerticalAlignment="Center"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200"
                                Value="{Binding Pressure}" TickFrequency="5" Margin="4,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ロットID" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LotId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="4,2" Padding="4,2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="レシピID" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RecipeId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="4,2" Padding="4,2"/>

                        <Button Grid.Row="4" Grid.Column="1" Content="値を更新"
                                Style="{StaticResource Btn}" Command="{Binding UpdateValuesCommand}"/>
                    </Grid>
                </GroupBox>

                <!-- イベント送信 -->
                <GroupBox Header="イベント送信 (Collection Events)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Button Content="LotStarted (CEID=103)" Style="{StaticResource Btn}"
                                Command="{Binding SendLotStartedCommand}"/>
                        <Button Content="LotCompleted (CEID=104)" Style="{StaticResource Btn}"
                                Command="{Binding SendLotCompletedCommand}"/>
                    </StackPanel>
                </GroupBox>

                <!-- レシピ管理 -->
                <GroupBox Header="レシピ管理 (Process Program / S7)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding RecipeList}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Height="110" FontSize="11"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PPID"     Binding="{Binding PpId}"         Width="80"/>
                                <DataGridTextColumn Header="Size(B)"  Binding="{Binding Size}"         Width="55"/>
                                <DataGridTextColumn Header="更新時刻" Binding="{Binding LastModified}"  Width="90"/>
                                <DataGridTextColumn Header="プレビュー" Binding="{Binding BodyPreview}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="※ レシピはホストから S7F3 で送信されます"
                                   FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- アラーム操作 -->
                <GroupBox Header="アラーム管理" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding AlarmList}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Height="130" FontSize="11"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ALID" Binding="{Binding AlarmId}" Width="40"/>
                                <DataGridTextColumn Header="コード" Binding="{Binding AlarmCode}" Width="80"/>
                                <DataGridTemplateColumn Header="状態" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding IsSet, Converter={StaticResource BoolToAlarmColor}}"
                                                     HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <UniformGrid Rows="1" Columns="3" Margin="0,4,0,0">
                            <Button Content="AL1 SET" Style="{StaticResource Btn}"
                                    Command="{Binding SetAlarmCommand}" CommandParameter="1"/>
                            <Button Content="AL2 SET" Style="{StaticResource Btn}"
                                    Command="{Binding SetAlarmCommand}" CommandParameter="2"/>
                            <Button Content="全クリア" Style="{StaticResource Btn}"
                                    Command="{Binding ClearAllAlarmsCommand}"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <!-- ポート管理 -->
                <GroupBox Header="ポート管理 (Load Port / E87)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding PortList}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Height="80" FontSize="11"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"         Binding="{Binding PortId}"    Width="30"/>
                                <DataGridTextColumn Header="名前"       Binding="{Binding PortName}"  Width="55"/>
                                <DataGridTextColumn Header="状態"       Binding="{Binding State}"     Width="90"/>
                                <DataGridTextColumn Header="モード"     Binding="{Binding AccessMode}" Width="50"/>
                                <DataGridTextColumn Header="キャリアID" Binding="{Binding CarrierId}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <!-- キャリア管理 -->
                <GroupBox Header="キャリア管理 (Carrier / E87)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding CarrierList}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Height="70" FontSize="11"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="キャリアID" Binding="{Binding CarrierId}" Width="90"/>
                                <DataGridTextColumn Header="PortID"     Binding="{Binding PortId}"    Width="50"/>
                                <DataGridTextColumn Header="状態"       Binding="{Binding State}"     Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- キャリアロード操作 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox   Grid.Column="1" Text="{Binding LoadCarrierId, UpdateSourceTrigger=PropertyChanged}"
                                       Padding="3,2" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text=" P:" VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="3" Text="{Binding LoadPortIdStr, UpdateSourceTrigger=PropertyChanged}"
                                       Width="25" Padding="3,2" FontSize="11"/>
                        </Grid>
                        <!-- アンロード操作 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ロード" Style="{StaticResource Btn}"
                                    Command="{Binding LoadCarrierCommand}"/>
                            <Button Grid.Column="1" Content="アンロード P:" Style="{StaticResource Btn}"
                                    Command="{Binding UnloadCarrierCommand}"/>
                            <TextBox Grid.Column="2" Text="{Binding UnloadPortIdStr, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="3,2" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
            </ScrollViewer>

            <!-- 右パネル: ログ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="通信ログ (Message Log)" FontSize="13" FontWeight="Bold"
                               Foreground="#334155" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="ログクリア" Style="{StaticResource Btn}"
                            Command="{Binding ClearLogCommand}"/>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                    <ListBox ItemsSource="{Binding MessageLog}"
                             FontFamily="Consolas, MS Gothic, Meiryo" FontSize="11"
                             Background="#0F172A" Foreground="#E2E8F0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1"/>
                                <Setter Property="FontFamily" Value="Consolas, MS Gothic, Meiryo"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="">
                                        <Setter Property="Height" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
