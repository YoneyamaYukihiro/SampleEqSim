<Window x:Class="SampleEqSim.Host.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SampleEqSim.Host.Views.Converters"
        xmlns:v="clr-namespace:SampleEqSim.Host.Views"
        mc:Ignorable="d"
        Title="SECS/GEM Host Simulator [ホスト]" Height="800" Width="1150"
        Icon="pack://application:,,,/host.ico"
        Background="#EEF2FF">

    <Window.Resources>
        <conv:StringToLedBrushConverter x:Key="LedBrush"/>
        <conv:StringToForegroundConverter x:Key="FgConverter"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CategoryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="LedIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" Background="#1E40AF" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LedIndicator}"
                             Fill="{Binding ConnectionLedBrush, Converter={StaticResource LedBrush}}"
                             Width="14" Height="14"/>
                    <TextBlock Text="🖥 HOST ホストシミュレータ  "
                               FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionSummary}"
                               FontSize="13" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStateText}" FontSize="13"
                               Foreground="{Binding ConnectionLedBrush, Converter={StaticResource LedBrush}}"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentTime}"
                           FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 装置情報バー -->
        <Border DockPanel.Dock="Top" Background="#1E3A8A" Padding="12,6">
            <UniformGrid Rows="1" Columns="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Model:" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EquipmentModel}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SoftRev:" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EquipmentSoftRev}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DateTime:" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EquipmentDateTime}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CtrlState:" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EquipmentControlState}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ProcState:" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EquipmentProcState}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左パネル: コマンド (タブ化) -->
            <TabControl Grid.Column="0" Margin="0,0,8,0">
                <TabItem Header="接続">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 接続設定 (HSMS) -->
                    <GroupBox Header="接続設定 (HSMS)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="IPアドレス" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="4,2" Padding="4,2"
                                           Text="{Binding ConnIpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ポート" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="4,2" Padding="4,2"
                                           Text="{Binding ConnPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="DeviceId" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Margin="4,2" Padding="4,2"
                                           Text="{Binding ConnDeviceId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <CheckBox Content="Active モード (自分から装置へ接続する)" Margin="4,4"
                                      IsChecked="{Binding ConnIsActive}"/>
                            <TextBlock Text="※ 実機装置の IP・ポート・DeviceId を設定。保存すると確認後にアプリを再起動して反映します。"
                                       FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="4,0"/>
                            <Button Content="保存して再接続 (再起動)" Style="{StaticResource Btn}" Margin="4,4,4,0"
                                    Command="{Binding SaveAndReconnectCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- シーケンス監視 -->
                    <GroupBox Header="シーケンス監視 (想定順序との照合)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding SequenceStatusBrush, Converter={StaticResource LedBrush}}"/>
                                    <TextBlock Text="{Binding SequenceName}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="再読込"  Style="{StaticResource Btn}" Command="{Binding ReloadSequenceCommand}"/>
                                <Button Grid.Column="2" Content="リセット" Style="{StaticResource Btn}" Command="{Binding ResetSequenceCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding SequenceStatus}" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{Binding SequenceStatusBrush, Converter={StaticResource LedBrush}}"/>
                            <ItemsControl ItemsSource="{Binding SequenceSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="11" Height="11" Margin="2,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush, Converter={StaticResource LedBrush}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10" Foreground="#64748B"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="※ sequence.json (exe同フォルダ) の順序と実通信を照合。緑=受信 / 黄=次に期待 / 赤=スキップ・逸脱"
                                       FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 接続管理 (Stream 1) -->
                    <GroupBox Header="接続管理 (Stream 1)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <Button Content="S1F1  Are You There" Style="{StaticResource Btn}"
                                    Command="{Binding SendS1F1Command}"/>
                            <Button Content="S1F13 Establish Communications" Style="{StaticResource Btn}"
                                    Command="{Binding SendS1F13Command}"/>
                            <Button Content="S1F17 Request ON-LINE" Style="{StaticResource Btn}"
                                    Command="{Binding SendS1F17Command}"/>
                            <Button Content="S1F15 Request OFF-LINE" Style="{StaticResource Btn}"
                                    Command="{Binding SendS1F15Command}"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <TabItem Header="制御/収集">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 装置制御 (Stream 2) -->
                    <GroupBox Header="装置制御 (Stream 2)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <Button Content="S2F17 Date/Time Request" Style="{StaticResource Btn}"
                                    Command="{Binding SendS2F17Command}"/>
                            <!-- ホストコマンド -->
                            <Separator Margin="0,4"/>
                            <TextBlock Text="S2F41 Host Command:" FontSize="11" Margin="0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding HostCommandText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,4" FontSize="11"/>
                                <Button Grid.Column="1" Content="送信" Style="{StaticResource Btn}"
                                        Command="{Binding SendHostCommandCommand}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Content="START" Style="{StaticResource Btn}">
                                    <Button.Command>
                                        <Binding Path="SendHostCommandCommand"/>
                                    </Button.Command>
                                </Button>
                                <Button Content="STOP" Style="{StaticResource Btn}"
                                        Command="{Binding SendHostCommandCommand}"/>
                                <Button Content="PAUSE" Style="{StaticResource Btn}"
                                        Command="{Binding SendHostCommandCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- データ収集設定 -->
                    <GroupBox Header="データ収集設定" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <Button Content="S2F33 Define Report (RPTID=1)" Style="{StaticResource Btn}"
                                    Command="{Binding DefineReportCommand}"/>
                            <Button Content="S2F35 Link Event Report" Style="{StaticResource Btn}"
                                    Command="{Binding LinkEventReportCommand}"/>
                            <Button Content="S2F37 Enable All Events" Style="{StaticResource Btn}"
                                    Command="{Binding EnableAllEventsCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ステータス変数 -->
                    <GroupBox Header="ステータス変数 (S1F3)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <TextBlock Text="SVID (カンマ区切り):" FontSize="11"/>
                            <TextBox Text="{Binding RequestSvIds, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,4" FontSize="11" Margin="0,2"/>
                            <Button Content="S1F3 SV Request" Style="{StaticResource Btn}"
                                    Command="{Binding RequestStatusVariablesCommand}"/>
                            <TextBox Text="{Binding SvDataResult, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas, MS Gothic, Meiryo" FontSize="10"
                                     Background="#F1F5F9" Padding="4" MinHeight="50"
                                     TextWrapping="Wrap" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <TabItem Header="レシピ/アラーム">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- レシピ管理 (Stream 7) -->
                    <GroupBox Header="レシピ管理 (Process Program / S7)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <TextBlock Text="PPID:" FontSize="11"/>
                            <TextBox Text="{Binding RecipePpId, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" FontSize="11" Margin="0,2"/>
                            <TextBlock Text="レシピボディ:" FontSize="11" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding RecipeBody, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" FontSize="11" Margin="0,2"
                                     AcceptsReturn="True" Height="55"
                                     FontFamily="Consolas, MS Gothic, Meiryo"
                                     VerticalScrollBarVisibility="Auto"/>
                            <UniformGrid Rows="1" Columns="3" Margin="0,4,0,0">
                                <Button Content="S7F1+F3 PP送信" Style="{StaticResource Btn}"
                                        Command="{Binding SendProcessProgramCommand}"/>
                                <Button Content="S7F17 PP削除"   Style="{StaticResource Btn}"
                                        Command="{Binding DeleteProcessProgramCommand}"/>
                                <Button Content="S7F19 一覧取得" Style="{StaticResource Btn}"
                                        Command="{Binding RequestPpDirectoryCommand}"/>
                            </UniformGrid>
                            <TextBlock Text="{Binding RecipeDirectory, StringFormat='格納済: {0}'}"
                                       FontSize="10" Foreground="#475569" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- アラーム -->
                    <GroupBox Header="アラーム管理 (Stream 5)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <Button Content="S5F5 List Alarms" Style="{StaticResource Btn}"
                                    Command="{Binding ListAlarmsCommand}"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <TabItem Header="E87 ポート/キャリア">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ポート/キャリア管理 (Stream 14 / E87) -->
                    <GroupBox Header="ポート/キャリア管理 (S14 / E87)" Margin="0,0,0,6" Padding="6">
                        <StackPanel>
                            <UniformGrid Rows="1" Columns="2" Margin="0,0,0,4">
                                <Button Content="S14F1 ポート属性取得"   Style="{StaticResource Btn}"
                                        Command="{Binding GetPortAttrCommand}"/>
                                <Button Content="S14F1 キャリア属性取得" Style="{StaticResource Btn}"
                                        Command="{Binding GetCarrierAttrCommand}"/>
                            </UniformGrid>
                            <TextBox Text="{Binding PortCarrierInfo, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas, MS Gothic, Meiryo" FontSize="10"
                                     Background="#F1F5F9" Padding="4" MinHeight="60"
                                     TextWrapping="Wrap" Margin="0,2"
                                     VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="※ キャリアIN/OUTはイベントログに表示されます"
                                       FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 右パネル: ログ + イベントログ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <!-- 通信ログ -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="通信ログ (Message Log)" FontSize="13" FontWeight="Bold"
                                   Foreground="#334155" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Content="ログクリア" Style="{StaticResource Btn}"
                                Command="{Binding ClearLogCommand}"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                        <ListView ItemsSource="{Binding MessageLog}"
                                  v:AutoScroll.ToEnd="True"
                                  FontFamily="Consolas, MS Gothic, Meiryo" FontSize="11"
                                  Background="#0F172A"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="時刻" Width="85">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TimeText}" Foreground="#94A3B8" FontSize="10"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="メッセージ" Width="600">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="{Binding ForegroundColor, Converter={StaticResource FgConverter}}"
                                                           FontSize="11"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="2,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </Grid>

                <!-- イベントログ -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="イベント・アラームログ" FontSize="13" FontWeight="Bold"
                                   Foreground="#334155" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Content="クリア" Style="{StaticResource Btn}"
                                Command="{Binding ClearEventLogCommand}"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding EventLog}"
                                 v:AutoScroll.ToEnd="True"
                                 FontFamily="Consolas, MS Gothic, Meiryo" FontSize="11"
                                 Background="#1E293B" Foreground="#FCD34D"
                                 VirtualizingPanel.IsVirtualizing="True"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
